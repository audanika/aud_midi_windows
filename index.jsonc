{
  "name": "aud_midi_windows",
  "summary": "The Windows backend of aud_midi: Windows.Devices.Midi and, when present, Windows MIDI Services, through a C++/WinRT shim.",
  "domain": [
    "Windows MIDI backend"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_core": "backend contracts",
      "aud_midi_standard": "models"
    },
    "usedBy": {
      "aud_midi": "consumes this package"
    }
  }
}
