{
  "name": "aud_midi_windows",
  "summary": "The Windows backend of aud_midi: WinRT MIDI 1.0 and, when built in and present, Windows MIDI Services through a C++/WinRT shim; BLE-MIDI pairing; DNS-SD advertising.",
  "domain": [
    "Windows MIDI backend: ports, hotplug, timestamps, UMP, scheduling",
    "C++/WinRT shim with C API, built by hook, bound by ffigen",
    "BLE-MIDI pairing, virtual devices, DnsServiceRegister"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_core": "MidiBackend, MidiBackendHost, MidiClockMapper, MidiServiceAdvertiser, MidiException, MidiPortRegistry keys",
      "aud_midi_standard": "MidiPortInfo and other models, MidiBytes, MidiPacket, MidiTime"
    },
    "usedBy": {
      "aud_midi": "WindowsMidiBackend (name winrt), WindowsMidiServiceAdvertiser for aud_midi_network sessions"
    }
  }
}
